{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://todo-app.example.com/schemas/task-event.json",
  "title": "Task Event",
  "description": "Event schema for task CRUD operations (task-events topic)",
  "type": "object",
  "required": ["event_type", "task_id", "user_id", "task_data", "timestamp", "metadata"],
  "properties": {
    "event_type": {
      "type": "string",
      "enum": ["created", "updated", "completed", "deleted"],
      "description": "Type of task operation"
    },
    "task_id": {
      "type": "integer",
      "minimum": 1,
      "description": "Unique task identifier"
    },
    "user_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "description": "User who performed the action"
    },
    "task_data": {
      "type": "object",
      "description": "Full task data snapshot",
      "required": ["id", "user_id", "title", "completed", "created_at", "updated_at"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "user_id": { "type": "string", "maxLength": 255 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": ["string", "null"], "maxLength": 1000 },
        "completed": { "type": "boolean" },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "tags": {
          "type": ["array", "null"],
          "items": { "type": "string", "maxLength": 30 },
          "maxItems": 10
        },
        "due_date": { "type": ["string", "null"], "format": "date-time" },
        "remind_before_minutes": { "type": ["integer", "null"], "minimum": 1, "maximum": 10080 },
        "recurrence_pattern": { "type": ["string", "null"], "enum": ["daily", "weekly", "monthly", null] },
        "recurrence_interval": { "type": ["integer", "null"], "minimum": 1, "maximum": 365 },
        "recurrence_days": {
          "type": ["array", "null"],
          "items": {
            "type": "string",
            "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
          }
        },
        "recurrence_end_date": { "type": ["string", "null"], "format": "date-time" },
        "parent_task_id": { "type": ["integer", "null"], "minimum": 1 },
        "ai_generated": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when event occurred (UTC)"
    },
    "metadata": {
      "type": "object",
      "required": ["source", "version"],
      "properties": {
        "source": {
          "type": "string",
          "description": "Originating service",
          "examples": ["backend-api", "cron-service"]
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$",
          "description": "Event schema version",
          "examples": ["1.0", "1.1"]
        },
        "changes": {
          "type": "object",
          "description": "Changed fields (only for 'updated' event_type)",
          "additionalProperties": true
        },
        "is_recurring": {
          "type": "boolean",
          "description": "Whether task is recurring (only for 'completed' event_type)"
        }
      },
      "additionalProperties": true
    }
  }
}

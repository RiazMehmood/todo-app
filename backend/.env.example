# Backend Environment Variables

# Database Connection (Neon Serverless PostgreSQL)
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# Better Auth Secret (MUST match frontend secret)
BETTER_AUTH_SECRET=your-secret-key-here-min-32-chars

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://yourapp.vercel.app

# AI Configuration (Phase III - Chatbot Integration)
# Gemini API Key from Google AI Studio (https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
# Alternative: OPENAI_API_KEY (fallback if GEMINI_API_KEY not set)
# OPENAI_API_KEY=your-openai-api-key-here

# AI Model (default: gemini-2.0-flash-exp)
AI_MODEL=gemini-2.0-flash-exp

# Rate Limiting Configuration (Phase III - Polish)
# Chat endpoint rate limit: maximum messages per user per minute
CHAT_RATE_LIMIT_PER_USER=10
# Chat rate limit window in seconds (default: 60 = 1 minute)
CHAT_RATE_LIMIT_WINDOW=60

# General API rate limit: maximum requests per user per minute
API_RATE_LIMIT_PER_USER=100
# API rate limit window in seconds (default: 60 = 1 minute)
API_RATE_LIMIT_WINDOW=60
